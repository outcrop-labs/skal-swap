#!/usr/bin/env bash
# skal-swap — Claude Code API profile switcher.
#
# Companion CLI of the skal.swap Omarchy bar plugin.
# Profiles (name / base_url / token / extra env such as model mappings) live
# in an INI-style file OUTSIDE the plugin directory, so secrets never end up
# in a published repo:
#
#     ~/.config/skal.swap/profiles.conf   (chmod 600)
#
#     [zai-plan-a]
#     name = Z.AI plan A
#     base_url = https://api.z.ai/api/anthropic
#     token = ...
#     usage = zai          # optional: usage-account marker for the menu
#
# Model selection is settings.json's "model" key plus a "modelPicker" lineup
# built from the endpoint's own catalogue, not the ANTHROPIC_DEFAULT_* slot
# aliases and not ANTHROPIC_MODEL. The aliases leave the "model" pin in charge,
# so a pin like "opus" follows you onto every endpoint; ANTHROPIC_MODEL fixes
# that but outranks the pin, which would make /model inert mid-session. All
# those keys stay in MANAGED_BASE so a switch clears any left behind.
#
# A profile with no token/base_url (e.g. [anthropic-login]) clears the
# overrides and returns Claude Code to its OAuth login credentials.
#
# `use` rewrites the managed ANTHROPIC_* keys in ~/.claude/settings.json's
# env atomically: every managed key is removed first, then the target
# profile's keys are written — so switching providers never leaves a stale
# endpoint or model mapping behind. It also sets "model" and "modelPicker"
# for the target endpoint, restoring the previous pin and the built-in picker
# when you return to the OAuth profile. All other settings are untouched.
# Already-running claude sessions keep the previous key until restarted.
#
# Overrides for testing: CCS_PROFILES, CCS_SETTINGS, GLM_KEYS.

set -euo pipefail

# Everything this tool creates is private by default: profiles.conf and the
# credential/home stores hold live API keys and OAuth bundles, and several
# are written by redirection with chmod only afterwards — a permissive umask
# would leave a 0644 window (or a retained descriptor) around real secrets.
umask 077

PROFILES="${CCS_PROFILES:-$HOME/.config/skal.swap/profiles.conf}"
SETTINGS="${CCS_SETTINGS:-$HOME/.claude/settings.json}"
CREDS="${CCS_CREDS:-$HOME/.claude/.credentials.json}"
CLAUDE_JSON="${CCS_CLAUDE_JSON:-$HOME/.claude.json}"
STATE_DIR="${CCS_STATE:-$HOME/.local/state/skal.swap}"
CRED_DIR="${CCS_CRED_DIR:-$HOME/.config/skal.swap/credentials}"
OAUTH_STATE="$STATE_DIR/active-oauth"
GLM_KEYS="${GLM_KEYS:-$HOME/.config/glm-keys.env}"
# One Claude Code config dir per profile, for `run` and for logins that are
# not the machine's current one. See "Claude logins" below.
HOMES_DIR="${CCS_HOMES:-$HOME/.local/share/skal.swap/homes}"
CLAUDE_DIR="${CCS_CLAUDE_DIR:-$(dirname "$SETTINGS")}"
HOSTS_FILE="${CCS_HOSTS:-$HOME/.config/skal.swap/hosts.conf}"
OAUTH_USAGE_URL="${CCS_OAUTH_USAGE_URL:-https://api.anthropic.com/api/oauth/usage}"

# Env keys this tool owns. Cleared on every switch, then re-set from the
# target profile (plus any env.* key any profile sets).
readonly -a MANAGED_BASE=(
  ANTHROPIC_AUTH_TOKEN
  ANTHROPIC_API_KEY
  ANTHROPIC_BASE_URL
  ANTHROPIC_MODEL
  ANTHROPIC_SMALL_FAST_MODEL
  ANTHROPIC_DEFAULT_HAIKU_MODEL
  ANTHROPIC_DEFAULT_SONNET_MODEL
  ANTHROPIC_DEFAULT_OPUS_MODEL
  ANTHROPIC_CUSTOM_MODEL_OPTION
  ANTHROPIC_CUSTOM_MODEL_OPTION_NAME
  ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION
  CLAUDE_CODE_MAX_CONTEXT_TOKENS
  CLAUDE_CODE_MAX_OUTPUT_TOKENS
)

declare -A P_NAME=() P_BASE=() P_TOKEN=() P_USAGE=() P_ICON=() P_OAUTH=()
declare -A P_MODEL=() P_MODELS_URL=() P_BEHAVES_AS=() P_CONTEXT=() P_MAX_OUTPUT=()
declare -A PROFILE_SET=()
declare -a PROFILE_IDS=()
declare -a ENV_LINES=()

die() { echo "skal-swap: $*" >&2; exit 1; }
mask() { printf '%s…' "${1:0:8}"; }

usage() {
    cat <<'EOF'
usage: skal-swap [command]

  status          which profile Claude Code is on (default)
  status --json   {current, current_known, profiles[]} for the bar widget
  list            table of configured profiles
  use <id>        switch Claude Code to a profile
                  [--model <model-id>] also pick the model, remembered per
                  profile and written as settings.json's "model"
  run <id> [-- claude args]
                  launch claude on a profile without switching the machine:
                  each profile gets its own config dir, so several Claude
                  plans (and providers) can run side by side
                  [-y|--skip-permissions] adds --dangerously-skip-permissions
  login [<id>]    log a Claude subscription into a profile [--name N]
                  [--email E]; creates the profile when it doesn't exist.
                  Every machine logs in on its own (a refresh token shared
                  between machines knocks the other one out)
  models [<id>]   models the endpoint reports, discovered from its own
                  catalogue (* = active) [--refresh] [--json]
  swap [<id>]     switch profile: with an id, straight to it; without one, a
                  numbered picker (enter a row number or an id; blank stays);
                  with no terminal attached (bar hotkey) it quick-toggles
                  between the first two profiles
  edit            open the profiles file in $EDITOR
  init            write an example profiles file
  oauth-add <id>  store the currently-logged-in Claude OAuth account as a
                  profile [--name N] [--force] — log into another account
                  with claude /login and repeat to add more
  migrate-glm     import ~/.config/glm-keys.env + the active key [--force]
  usage --json    per-account usage from ai-usagebar plus each Claude
                  login's own limits, normalized
                  [--max-age N] serve the disk cache under N seconds old
                  (default 300; 0 = always fetch)

  hosts [--json]  other machines from hosts.conf (name = ssh destination)
  @<host> <cmd…>  run any command on that machine, e.g. skal-swap @devbox
                  run claude-max; run/login/edit get a terminal
  push <host>     install this CLI on a host [--profiles: also copy
                  profiles.conf when the host has none]
  sync <host>     bring a machine up to this one: this CLI, herdr's
                  config.toml and agent integrations, herdr's saved machine
                  [--dest user@host] adds a new host first
                  [--profiles] [--no-herdr]
  herdr [-y] <id> open a herdr tab running claude on a profile
                  [--cwd DIR] [--workspace] [--no-focus] [-- claude args]
  herdr-show      bring the local herdr window up (or open one)
  fleet --json    snapshot of this machine and every host, for the widget

profiles : ~/.config/skal.swap/profiles.conf
hosts    : ~/.config/skal.swap/hosts.conf
homes    : ~/.local/share/skal.swap/homes/<id> (CLAUDE_CONFIG_DIR per profile)
settings : ~/.claude/settings.json (env.ANTHROPIC_*, env.CLAUDE_CODE_MAX_{CONTEXT,OUTPUT}_TOKENS, model, modelPicker, autoCompactWindow)
EOF
    exit "${1:-0}"
}

parse_profiles() { # emits: id \t key \t value
    awk '
        /^[ \t]*(#|$)/ { next }
        /^[ \t]*\[/ {
            sec = $0
            sub(/^[ \t]*\[/, "", sec); sub(/\].*$/, "", sec)
            gsub(/[ \t]/, "", sec)
            next
        }
        sec == "" { next }
        {
            eq = index($0, "="); if (!eq) next
            key = substr($0, 1, eq - 1); val = substr($0, eq + 1)
            sub(/^[ \t]+/, "", key); sub(/[ \t]+$/, "", key)
            sub(/^[ \t]+/, "", val); sub(/[ \t]+$/, "", val)
            # \047 = apostrophe, spelled octally so this program stays in
            # one shell-safe single-quoted string
            if (length(val) > 1 && substr(val, length(val), 1) == substr(val, 1, 1) &&
                (substr(val, 1, 1) == "\"" || substr(val, 1, 1) == "\047"))
                val = substr(val, 2, length(val) - 2)
            print sec "\t" key "\t" val
        }
    ' "$PROFILES"
}

load_profiles() {
    [[ -r $PROFILES ]] || die "no profiles file at $PROFILES — start with: skal-swap init"
    local sec key val
    local -A seen=()
    while IFS=$'\t' read -r sec key val; do
        [[ -n ${seen[$sec]+x} ]] || { seen[$sec]=1; PROFILE_IDS+=("$sec"); PROFILE_SET[$sec]=1; }
        case $key in
            name) P_NAME[$sec]=$val ;;
            model) P_MODEL[$sec]=$val ;;
            models_url) P_MODELS_URL[$sec]=$val ;;
            behaves_as) P_BEHAVES_AS[$sec]=$val ;;
            context)
                [[ $val =~ ^[0-9]+$ ]] || echo "skal-swap: [$sec] context must be a whole number of tokens (got '$val')" >&2
                P_CONTEXT[$sec]=$val ;;
            max_output)
                [[ $val =~ ^[0-9]+$ ]] || echo "skal-swap: [$sec] max_output must be a whole number of tokens (got '$val')" >&2
                P_MAX_OUTPUT[$sec]=$val ;;
            base_url) P_BASE[$sec]=$val ;;
            token) P_TOKEN[$sec]=$val ;;
            usage) P_USAGE[$sec]=$val ;;
            icon) P_ICON[$sec]=$val ;;
            oauth) [[ $val == "true" || $val == "yes" || $val == "1" ]] && P_OAUTH[$sec]=1 ;;
            env.*) ENV_LINES+=("$sec"$'\t'"${key#env.}"$'\t'"$val") ;;
            *) echo "skal-swap: ignoring unknown key '$key' in [$sec]" >&2 ;;
        esac
    done < <(parse_profiles)
}

# Bump the version segment whenever the cached shape or ordering changes;
# the new path simply misses, so stale caches never outlive their format.
MODELS_DIR="$STATE_DIR/models/v3"
MODELS_TTL="${CCS_MODELS_TTL:-86400}"
# A catalogue response is held in memory before jq sees it, so it gets a hard
# ceiling as well as a timeout: a provider that misbehaves (or is compromised)
# must not be able to stream an endless body into this process. 4 MiB is about
# six times the largest real catalogue going (OpenRouter's, ~730 KB); anything
# past it fails closed and the next candidate URL is tried.
MODELS_MAX_BYTES="${CCS_MODELS_MAX_BYTES:-4194304}"
BEHAVES_AS_DEFAULT="${CCS_BEHAVES_AS:-claude-sonnet-4-5}"

# Ask an endpoint what it serves. Anthropic-format gateways expose
# GET /v1/models; ones that don't (Alibaba's token-plan gateway answers 404
# "Not support") simply yield nothing and the profile's `model` key stands.
# Claude Code's own CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY is no help
# here: it keeps only ids containing "claude" or "anthropic".
model_urls() { # model_urls <profile-id> -> candidate listing URLs, best first
    local id=$1 base=${P_BASE[$id]:-} origin trimmed
    [[ -n ${P_MODELS_URL[$id]:-} ]] && { printf '%s\n' "${P_MODELS_URL[$id]}"; return; }
    # No base_url means Claude Code's own OAuth login, whose endpoint is
    # Anthropic's; its catalogue is what reports those models' output caps.
    [[ -n $base ]] || { printf '%s\n' "$ANTHROPIC_MODELS_URL"; return 0; }
    base=${base%/}
    origin=$(printf '%s' "$base" | sed -E 's#^(https?://[^/]+).*#\1#')
    trimmed=${base%/*}                      # drop the dialect segment (…/apps/anthropic -> …/apps)
    # Anthropic-native first, then the OpenAI-compatible mode several
    # providers park the catalogue under (Alibaba serves only that one).
    printf '%s\n' \
        "$base/v1/models?limit=1000" \
        "$origin/compatible-mode/v1/models" \
        "$trimmed/v1/models" \
        "$origin/v1/models" \
        | awk '!seen[$0]++'
}

# Deducing the output cap from the catalogue: Anthropic's Models API reports
# it as max_tokens (alongside max_input_tokens for the window), OpenRouter as
# top_provider.max_completion_tokens, others as max_output_tokens. Plenty of
# OpenAI-shaped listings reuse "max_tokens" for the *context* length, so a bare
# max_tokens only counts when a separate input/context field is there to tell
# the two apart, and a figure equal to that window is dropped as the same
# mislabelling. Anything unrecognised leaves the column empty and Claude Code's
# own default stands.
readonly MODELS_JQ='
    def outcap:
      . as $m
      | ($m.max_input_tokens // $m.context_length // $m.context_window // null) as $in
      | (try ($m.top_provider | if type == "object" then .max_completion_tokens else null end)
         catch null) as $tp
      | ($m.max_output_tokens // $tp // $m.max_completion_tokens
         // (if $in != null then $m.max_tokens else null end)) as $out
      | if ($out | type) == "number" and $out > 0 and $out != $in then $out else null end;
    .data // [] | map(select(.id))
    | map(select(.id | ascii_downcase
          | test("audio|image|video|tts|asr|realtime|embed|rerank|ocr|speech|voice|whisper|diffusion") | not))
    | map(. + {_c: ((.created_at // .created // "") | tostring),
               _o: (try outcap catch null),
               _full: (if (.id | ascii_downcase
                       | test("flash|air|mini|lite|turbo|small|nano"))
                       then 0 else 1 end)})
    | sort_by([._c, ._full]) | reverse
    | .[] | [.id, (.display_name // .id), (._o // "" | tostring)] | @tsv'

ANTHROPIC_MODELS_URL="${CCS_ANTHROPIC_MODELS_URL:-https://api.anthropic.com/v1/models?limit=1000}"

# Access token for a profile that rides Claude Code's OAuth login: wherever
# that login lives right now, else whatever session is live.
oauth_token_of() { # oauth_token_of <profile-id> -> token or empty
    local f tok=""
    f=$(creds_file_of "$1")
    [[ -n $f ]] && tok=$(jq -r '.claudeAiOauth.accessToken // empty' "$f" 2>/dev/null || true)
    [[ -n $tok ]] || tok=$(jq -r '.claudeAiOauth.accessToken // empty' "$CREDS" 2>/dev/null || true)
    printf '%s' "$tok"
}

curl_config_header() { # curl_config_header <name> <value> -> one --config line
    local name=$1 value=$2
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    printf 'header = "%s: %s"\n' "$name" "$value"
}

fetch_models() { # fetch_models <profile-id> -> id \t display_name \t max_output
    local id=$1 tok=${P_TOKEN[$id]:-} url resp out config
    config=$(curl_config_header "anthropic-version" "2023-06-01")$'\n'
    if [[ -z ${P_BASE[$id]:-} ]]; then
        # Anthropic's catalogue behind an OAuth session: bearer only, and it
        # wants the oauth beta header. An api-key header alongside it is
        # rejected outright.
        tok=$(oauth_token_of "$id")
        [[ -n $tok ]] || return 1
        config+=$(curl_config_header "anthropic-beta" "oauth-2025-04-20")$'\n'
        config+=$(curl_config_header "authorization" "Bearer $tok")$'\n'
    elif [[ -n $tok ]]; then
        config+=$(curl_config_header "authorization" "Bearer $tok")$'\n'
        config+=$(curl_config_header "x-api-key" "$tok")$'\n'
    fi
    while read -r url; do
        [[ -n $url ]] || continue
        # --max-filesize aborts the transfer (non-zero exit, so `continue`
        # takes us to the next URL). It leans on Content-Length, which a
        # chunked response doesn't carry, so the byte count is re-checked here
        # for the curl builds that treat the flag as advisory.
        # Auth headers ride a private fd via --config, not -H on argv: while
        # curl runs, /proc/<pid>/cmdline would otherwise hold the bearer and
        # api-key. Deadline, size cap, TLS verification, and fail-closed
        # behaviour are unchanged.
        resp=$(curl -sS -m 10 --max-filesize "$MODELS_MAX_BYTES" \
            --config /dev/fd/3 "$url" 3<<<"$config" 2>/dev/null) || continue
        if [[ $(printf '%s' "$resp" | wc -c) -gt $MODELS_MAX_BYTES ]]; then
            echo "skal-swap: [$id] $url returned more than $MODELS_MAX_BYTES bytes — ignored" >&2
            continue
        fi
        out=$(printf '%s' "$resp" | jq -r "$MODELS_JQ" 2>/dev/null) || continue
        if [[ -n $out ]]; then
            printf '%s\n' "$out"
            return 0
        fi
    done < <(model_urls "$id")
    return 1
}

models_cached() { # models_cached <profile-id> [--refresh]
    local id=$1 refresh=${2:-} f="$MODELS_DIR/$id.tsv" now age
    mkdir -p "$MODELS_DIR"
    if [[ -s $f && $refresh != "--refresh" ]]; then
        now=$(date +%s); age=$(( now - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
        [[ $age -lt $MODELS_TTL ]] && { cat "$f"; return 0; }
    fi
    local out
    if out=$(fetch_models "$id") && [[ -n $out ]]; then
        printf '%s\n' "$out" >|"$f"
        printf '%s\n' "$out"
    else
        [[ -s $f ]] && cat "$f"   # stale beats nothing
    fi
    return 0
}

cmd_models() {
    local id="" refresh="" json=0 a
    for a in "$@"; do
        case $a in
            --refresh) refresh=--refresh ;;
            --json) json=1 ;;
            *) id=$a ;;
        esac
    done
    [[ -n $id ]] || { id=$(current_id) || die "no active profile — name one: skal-swap models <id>"; }
    [[ -n ${PROFILE_SET[$id]:-} ]] || die "no profile '$id' (see: skal-swap list)"
    local tsv chosen
    tsv=$(models_cached "$id" "$refresh")
    chosen=$(effective_model_of "$id")
    if [[ $json == 1 ]]; then
        printf '%s' "$tsv" | jq -R -s --arg cur "$chosen" --arg pid "$id" '
            split("\n") | map(select(length > 0)) | map(split("\t"))
            | {profile: $pid, current: (if $cur == "" then null else $cur end),
               models: map({id: .[0], name: .[1], active: (.[0] == $cur),
                            max_output: (if (.[2] // "") == "" then null else (.[2] | tonumber) end)})}'
        return
    fi
    if [[ -z $tsv ]]; then
        echo "$id: endpoint serves no model list${chosen:+ — using $chosen from profiles.conf}"
        return
    fi
    local mid mname mout
    while IFS=$'\t' read -r mid mname mout; do
        [[ -n $mid ]] || continue
        printf '%s %-28s %-28s %s\n' "$([[ $mid == "$chosen" ]] && echo '*' || echo ' ')" \
            "$mid" "$mname" "${mout:+max out ${mout}}"
    done <<<"$tsv"
}

host_of() {
    local u=${1:-}
    [[ -n $u ]] || { echo "api.anthropic.com"; return; }
    u=${u#*://}
    echo "${u%%/*}"
}

# Display label: `name` if given, else the endpoint host, else the section id.
label_of() { # label_of <profile-id>
    local id=$1
    [[ -n ${P_NAME[$id]:-} ]] && { printf '%s' "${P_NAME[$id]}"; return; }
    [[ -n ${P_BASE[$id]:-} ]] && { host_of "${P_BASE[$id]}"; return; }
    printf '%s' "$id"
}

# Provider mark for a profile (an asset in assets/providers/<name>.svg).
# Explicit `icon =` key wins; otherwise the endpoint host decides. Unknown
# hosts get the neutral three-bar mark.
icon_of() { # icon_of <profile-id>
    local id=$1
    [[ -n ${P_ICON[$id]:-} ]] && { printf '%s' "${P_ICON[$id]}" | tr -c 'a-z0-9-' '-'; return; }
    case $(host_of "${P_BASE[$id]:-}") in
    # Anthropic-compatible coding plans
    api.z.ai | z.ai | open.bigmodel.cn) echo zai ;;
    api.openai.com | openai.com) echo openai ;;
    api.moonshot.ai | api.moonshot.cn | kimi.com | api.kimi.com) echo kimi ;;
    api.minimax.io | minimax.io | api.minimaxi.com) echo minimax ;;
    api.xiaomimimo.com) echo xiaomi ;;
    api.stepfun.ai | api.stepfun.com) echo stepfun ;;
    api.x.ai | x.ai) echo x ;;
    # Direct pay-as-you-go APIs
    api.deepseek.com | deepseek.com | api.deepseek.cn) echo deepseek ;;
    api.mistral.ai | mistral.ai) echo mistralai ;;
    api.groq.com | groq.com) echo groq ;;
    api.cerebras.ai | cerebras.ai) echo cerebras ;;
    generativelanguage.googleapis.com | aiplatform.googleapis.com) echo googlegemini ;;
    # Aggregators
    openrouter.ai | api.openrouter.ai) echo openrouter ;;
    kilo.ai | api.kilo.ai) echo kilo ;;
    api.novita.ai | novita.ai) echo novita ;;
    glama.ai | api.glama.ai) echo glama ;;
    opencode.ai | api.opencode.ai) echo opencode ;;
    api.siliconflow.com | api.siliconflow.cn) echo siliconflow ;;
    # Alibaba: DashScope pay-as-you-go and the regional token-plan gateways
    *aliyuncs.com | *dashscope* | *maas.aliyuncs.com) echo qwen ;;
    huggingface.co | api.huggingface.co) echo huggingface ;;
    # Local
    localhost* | 127.0.0.1*) [[ ${P_BASE[$id]:-} == *:11434* ]] && echo ollama || echo generic ;;
    api.anthropic.com) echo claude ;;
    *) echo generic ;;
    esac
}

# --- Claude logins ----------------------------------------------------------
#
# A profile with no base_url and no token (or `oauth = true`) is a Claude
# subscription login. Claude Code keeps one login per config dir:
# <dir>/.credentials.json plus the oauthAccount block in the dir's
# .claude.json (~/.claude.json for the default dir). Every login profile owns
# a config dir of its own under HOMES_DIR, so `run <id>` can start claude on
# that plan with CLAUDE_CONFIG_DIR while other plans keep running. Everything
# else in ~/.claude (projects, history, skills, plugins, CLAUDE.md, …) is
# symlinked in, so all plans share one working memory and /resume works
# across them.
#
# A login lives in exactly one place at a time, never copied: OAuth refresh
# tokens rotate, and two copies refreshing on their own end with one of them
# dead. `use <id>` moves the login out of its home into ~/.claude (and moves
# whichever login was there back into its own home first); `run <id>` while
# that login sits in ~/.claude moves it home again when the machine has since
# switched to a provider. The owner of a login is found by account uuid, so
# the bookkeeping survives a manual /login.
#
# Credentials are never synced between machines for the same reason. Each
# machine runs `login` itself.

is_oauth() { [[ ${P_OAUTH[$1]:-} == 1 || ( -z ${P_BASE[$1]:-} && -z ${P_TOKEN[$1]:-} ) ]]; }

home_of() { printf '%s/%s' "$HOMES_DIR" "$1"; }

has_creds() { [[ -f $1 ]] && jq -e '.claudeAiOauth.accessToken' "$1" >/dev/null 2>&1; }

# Token expiry in epoch ms; -1 when the file doesn't say. Claude Code zeroes
# it when a refresh is refused, so 0 reads as expired.
creds_expiry() { jq -r '.claudeAiOauth.expiresAt // -1' "$1" 2>/dev/null || echo -1; }

home_fingerprint() { # home_fingerprint <id> -> account uuid recorded in the profile's home
    jq -r '.oauthAccount.accountUuid // .oauthAccount.emailAddress // empty' \
        "$(home_of "$1")/.claude.json" 2>/dev/null || true
}

# Login profile whose home records this account ("" when none does).
profile_by_fp() { # profile_by_fp <fingerprint>
    local fp=$1 id
    [[ -n $fp ]] || return 0
    for id in "${PROFILE_IDS[@]}"; do
        is_oauth "$id" || continue
        [[ $(home_fingerprint "$id") == "$fp" ]] && { printf '%s' "$id"; return 0; }
    done
    return 0
}

# Login profile that owns the login in ~/.claude right now ("" when none).
# A login no home records yet (made with plain claude /login, or from before
# homes existed) belongs to claim_target.
global_owner() {
    has_creds "$CREDS" || return 0
    local o
    o=$(profile_by_fp "$(live_fingerprint)")
    [[ -n $o ]] || o=$(claim_target) || true
    printf '%s' "$o"
}

# Where a login profile's credentials are right now: ~/.claude when it is
# checked out there, else its home. Empty when it isn't logged in here.
creds_file_of() { # creds_file_of <id>
    local id=$1 h
    h="$(home_of "$id")/.credentials.json"
    if [[ $(global_owner) == "$id" ]]; then printf '%s' "$CREDS"
    elif has_creds "$h"; then printf '%s' "$h"
    fi
}

account_file_of() { # account_file_of <id> -> the .claude.json holding its oauthAccount
    if [[ $(global_owner) == "$1" ]]; then printf '%s' "$CLAUDE_JSON"
    else printf '%s' "$(home_of "$1")/.claude.json"; fi
}

plan_label() { # plan_label <subscriptionType> <rateLimitTier>
    case $1 in
    max) case $2 in *20x*) echo "Max 20x" ;; *5x*) echo "Max 5x" ;; *) echo "Max" ;; esac ;;
    pro) echo "Pro" ;;
    team) echo "Team" ;;
    enterprise) echo "Enterprise" ;;
    "") ;;
    *) echo "${1^}" ;;
    esac
}

# Running claude processes per config dir, counted once per call. A process
# without CLAUDE_CONFIG_DIR is on ~/.claude, keyed as "@default".
declare -A SESSIONS=()
SESSIONS_COUNTED=0
count_sessions() {
    [[ $SESSIONS_COUNTED == 1 ]] && return 0
    SESSIONS_COUNTED=1
    local pid dir
    for pid in $(pgrep -u "$(id -u)" -x claude 2>/dev/null || true); do
        dir=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^CLAUDE_CONFIG_DIR=//p' | head -1) || continue
        [[ -z $dir || $dir == "$CLAUDE_DIR" ]] && dir=@default
        SESSIONS[$dir]=$(( ${SESSIONS[$dir]:-0} + 1 ))
    done
}

sessions_in() { count_sessions; printf '%s' "${SESSIONS[${1:-@default}]:-0}"; }

# Entries of ~/.claude a profile home keeps to itself instead of linking:
# the login, the generated settings, and account-scoped state.
readonly -a HOME_PRIVATE=(
    .credentials.json settings.json .claude.json .claude.json.backup backups
    .device-keys.json .session_ingress_token policy-limits.json remote-settings.json
    daemon daemon.lock daemon.log daemon.status.json jobs .skal-prev-model
)

is_private() {
    local n=$1 p
    for p in "${HOME_PRIVATE[@]}"; do [[ $n == "$p" ]] && return 0; done
    return 1
}

# Build or refresh a profile's config dir: link anything new in ~/.claude,
# drop links whose target went away, seed .claude.json once (onboarding,
# project trust and MCP servers carry over, the account doesn't), and write
# settings.json for the profile from the current ~/.claude/settings.json.
prepare_home() { # prepare_home <id>
    local id=$1 h e n
    h=$(home_of "$id")
    mkdir -p "$h"
    chmod 700 "$h"
    for e in "$CLAUDE_DIR"/* "$CLAUDE_DIR"/.[!.]*; do
        [[ -e $e ]] || continue
        n=${e##*/}
        is_private "$n" && continue
        [[ -e $h/$n || -L $h/$n ]] || ln -s "$e" "$h/$n"
    done
    for e in "$h"/* "$h"/.[!.]*; do
        [[ -L $e && ! -e $e ]] && rm -f "$e"
    done
    if [[ ! -f $h/.claude.json ]]; then
        if [[ -f $CLAUDE_JSON ]]; then
            jq 'del(.oauthAccount, .clientDataCacheSlots, .primaryApiKey)' "$CLAUDE_JSON" >"$h/.claude.json"
        else
            echo '{}' >"$h/.claude.json"
        fi
        chmod 600 "$h/.claude.json"
    fi
    write_home_settings "$id"
}

# The profile's settings.json is regenerated from ~/.claude/settings.json on
# every launch, then given the profile's managed keys the same way `use`
# would, so a z.ai switch on the machine never leaks into a Claude plan's
# sessions, and settings you change in ~/.claude reach every profile.
write_home_settings() { # write_home_settings <id>
    local id=$1 h global=$SETTINGS
    h=$(home_of "$id")
    (
        SETTINGS="$h/settings.json"
        CLAUDE_JSON="$h/.claude.json"
        local prev="$PREV_MODEL"
        PREV_MODEL="$h/.skal-prev-model"
        if [[ -f $global ]]; then cat "$global" >"$SETTINGS"; else echo '{}' >"$SETTINGS"; fi
        if [[ -r $prev ]]; then cat "$prev" >"$PREV_MODEL"; else rm -f "$PREV_MODEL"; fi
        write_settings_for "$id"
        chmod 600 "$SETTINGS"
    )
}

# Move the login in ~/.claude into its owner's home. A login no profile
# claims goes to a login profile that has none yet (the one the machine is on
# first). Freshest wins when the home already holds one for the same account:
# a refresh rotates the token, so the older copy is the dead one.
checkin() {
    has_creds "$CREDS" || return 0
    local fp owner h
    fp=$(live_fingerprint)
    owner=$(profile_by_fp "$fp")
    if [[ -z $owner ]]; then
        owner=$(claim_target) || {
            echo "skal-swap: the login in $CREDS (${fp:-unknown account}) belongs to no profile, so it stays put. Claim it with: skal-swap oauth-add <id>" >&2
            return 1
        }
    fi
    prepare_home "$owner"
    h="$(home_of "$owner")/.credentials.json"
    if ! has_creds "$h" || (( $(creds_expiry "$CREDS") >= $(creds_expiry "$h") )); then
        cat "$CREDS" >|"$h"
    fi
    chmod 600 "$h"
    if [[ -f $CLAUDE_JSON ]] && jq -e '.oauthAccount' "$CLAUDE_JSON" >/dev/null 2>&1; then
        rewrite "$(home_of "$owner")/.claude.json" --slurpfile g "$CLAUDE_JSON" '.oauthAccount = $g[0].oauthAccount'
    fi
    rm -f "$CREDS"
    # Sessions on ~/.claude only hold this login when the machine is on it.
    [[ $(current_id 2>/dev/null) == "$owner" ]] && warn_sessions "" "$owner"
    return 0
}

# The legacy bundle swapper's last profile, else the first login profile
# with no account recorded yet.
claim_target() {
    local id
    for id in "$(active_oauth)" "${PROFILE_IDS[@]}"; do
        [[ -n $id && -n ${PROFILE_SET[$id]:-} ]] || continue
        is_oauth "$id" || continue
        [[ -z $(home_fingerprint "$id") ]] && { printf '%s' "$id"; return 0; }
    done
    return 1
}

# Move a profile's login from its home into ~/.claude.
checkout() { # checkout <id>
    local id=$1 h
    h="$(home_of "$id")/.credentials.json"
    has_creds "$h" || die "[$id] isn't logged in on this machine. Run: skal-swap login $id"
    cat "$h" >|"$CREDS"
    chmod 600 "$CREDS"
    if [[ -f $CLAUDE_JSON ]]; then
        rewrite "$CLAUDE_JSON" --slurpfile s "$(home_of "$id")/.claude.json" \
            '.oauthAccount = $s[0].oauthAccount'
    fi
    rm -f "$h"
    warn_sessions "$(home_of "$id")" "$id"
}

# Sessions still running on a config dir whose login just moved hold the old
# tokens in memory and will write refreshed ones back where they started.
warn_sessions() { # warn_sessions <config-dir|""> <id>
    local n
    n=$(sessions_in "$1")
    (( n > 0 )) || return 0
    echo "skal-swap: $n claude session(s) still running on $(label_of "$2")'s old location. Restart them so its tokens stay in one place" >&2
}

# The legacy bundle store (pre-homes): import it into the profile's home once.
import_legacy_store() { # import_legacy_store <id>
    local id=$1 store h
    store="$CRED_DIR/$id.json"
    [[ -f $store ]] || return 0
    h=$(home_of "$id")
    if ! has_creds "$h/.credentials.json" && [[ $(global_owner) != "$id" ]]; then
        prepare_home "$id"
        jq '{claudeAiOauth: .credentials}' "$store" >"$h/.credentials.json"
        chmod 600 "$h/.credentials.json"
        rewrite "$h/.claude.json" --slurpfile s "$store" '.oauthAccount = $s[0].oauthAccount'
    fi
    mv "$store" "$store.imported"
}

claude_bin() {
    local p
    for p in "${CCS_CLAUDE_BIN:-}" "$(command -v claude 2>/dev/null || true)" \
        "$HOME/.local/share/mise/installs/claude/latest/claude" "$HOME/.local/bin/claude" \
        "$HOME/.claude/local/claude"; do
        [[ -n $p && -x $p ]] && { printf '%s' "$p"; return 0; }
    done
    die "claude not found on PATH"
}

cmd_run() { # cmd_run [-y] <id> [-y] [--] [claude args…]
    local id="" yolo=0
    # Our own flags may sit before or right after the id; everything after
    # that (or after --) is claude's.
    while [[ $# -gt 0 ]]; do
        case $1 in
        -y | --yolo | --skip-permissions) yolo=1; shift ;;
        --) shift; break ;;
        *) [[ -z $id ]] || break; id=$1; shift ;;
        esac
    done
    [[ -n $id ]] || die "usage: skal-swap run [-y|--skip-permissions] <id> [-- claude args]"
    (( yolo )) && set -- --dangerously-skip-permissions "$@"
    load_profiles
    local bin dir
    bin=$(claude_bin)
    dir=$(launch_dir "$id") || exit 1
    [[ -n $dir ]] || exec "$bin" "$@"
    CLAUDE_CONFIG_DIR=$dir exec "$bin" "$@"
}

# Get a profile ready to launch and print the CLAUDE_CONFIG_DIR to use, or
# nothing when it is what the machine is already on (plain claude then).
launch_dir() { # launch_dir <id>
    local id=$1 cur
    [[ -n ${PROFILE_SET[$id]:-} ]] || die "no profile '$id' (see: skal-swap list)"
    cur=$(current_id 2>/dev/null) || cur=""
    [[ $cur == "$id" ]] && return 0
    if is_oauth "$id"; then
        import_legacy_store "$id"
        [[ $(global_owner) == "$id" ]] && checkin
        has_creds "$(home_of "$id")/.credentials.json" ||
            die "[$id] isn't logged in on this machine. Run: skal-swap login $id"
    fi
    prepare_home "$id"
    home_of "$id"
}

cmd_login() { # cmd_login [<id>] [--name N] [--email E]
    local id="" name="" email=""
    while [[ $# -gt 0 ]]; do
        case $1 in
        --name) name=${2:?--name needs a value}; shift 2 ;;
        --email) email=${2:?--email needs a value}; shift 2 ;;
        -*) die "unknown option: $1" ;;
        *) id=$1; shift ;;
        esac
    done
    if [[ -z $id ]]; then
        [[ -t 0 ]] || die "usage: skal-swap login <id> [--name N] [--email E]"
        read -rp "profile id (e.g. claude-max): " id
        [[ -n $name ]] || read -rp "display name (blank = account name): " name
    fi
    [[ $id =~ ^[A-Za-z0-9_.-]+$ ]] || die "profile ids are letters, digits, . _ and -"
    [[ -r $PROFILES ]] || { mkdir -p "$(dirname "$PROFILES")"; : >"$PROFILES"; chmod 600 "$PROFILES"; }
    load_profiles
    if [[ -n ${PROFILE_SET[$id]:-} ]]; then
        is_oauth "$id" || die "[$id] is a provider profile, not a Claude login"
    fi

    local bin h fp other
    bin=$(claude_bin)
    import_legacy_store "$id"
    # Logging in again replaces the login wherever it is: bring it home
    # first, and put the new one back where the old one was afterwards.
    local was_global=0
    [[ -n ${PROFILE_SET[$id]:-} && $(global_owner) == "$id" ]] && { was_global=1; checkin; }
    PROFILE_IDS+=("$id"); PROFILE_SET[$id]=1; P_OAUTH[$id]=1
    prepare_home "$id"
    h=$(home_of "$id")
    rm -f "$h/.credentials.json"
    local -a args=(auth login --claudeai)
    [[ -n $email ]] && args+=(--email "$email")
    CLAUDE_CONFIG_DIR=$h "$bin" "${args[@]}" || die "login failed"
    has_creds "$h/.credentials.json" || die "login finished without credentials in $h"
    chmod 600 "$h/.credentials.json" "$h/.claude.json"

    fp=$(home_fingerprint "$id")
    for other in "${PROFILE_IDS[@]}"; do
        [[ $other != "$id" ]] && is_oauth "$other" || continue
        [[ -n $fp && $(home_fingerprint "$other") == "$fp" ]] &&
            echo "skal-swap: warning: [$other] is the same account. One login per profile keeps tokens in one place" >&2
    done
    if ! grep -q "^[[:space:]]*\[$id\]" "$PROFILES"; then
        [[ -n $name ]] || name=$(jq -r '.oauthAccount.displayName // .oauthAccount.emailAddress // empty' "$h/.claude.json")
        printf '\n[%s]\nname = "%s"\noauth = true\n' "$id" "${name:-$id}" >>"$PROFILES"
    fi
    local sub tier
    sub=$(jq -r '.claudeAiOauth.subscriptionType // empty' "$h/.credentials.json")
    tier=$(jq -r '.claudeAiOauth.rateLimitTier // empty' "$h/.credentials.json")
    [[ $was_global == 1 ]] && checkout "$id"
    echo "[$id] logged in as $(jq -r '.oauthAccount.emailAddress // "?"' "$h/.claude.json")${sub:+ · $(plan_label "$sub" "$tier")}"
    echo "launch it with: skal-swap run $id"
}

# Effective model for a profile: a model picked at switch time wins, then the
# `model` key in profiles.conf. Empty means "say nothing" and let Claude Code
# resolve its own default against the endpoint.
model_state() { printf '%s/model-%s' "$STATE_DIR" "$1"; }

model_of() { # model_of <profile-id>
    local id=$1 f
    f=$(model_state "$id")
    if [[ -r $f ]]; then
        local v; v=$(<"$f")
        [[ -n $v ]] && { printf '%s' "$v"; return; }
    fi
    [[ -n ${P_MODEL[$id]:-} ]] && { printf '%s' "${P_MODEL[$id]}"; return; }
    # Nothing configured: take the newest model the endpoint reports.
    models_cached "$id" 2>/dev/null | head -1 | cut -f1
}

# On the OAuth profile the pin is Claude Code's own rather than one skal-swap
# wrote, so it is often an alias (`opus`) instead of a model id. Resolve an
# alias to the newest id of that family the catalogue lists; anything else is
# taken literally.
resolve_pin() { # resolve_pin <profile-id> <pin> -> catalogue id or empty
    local id=$1 pin=$2 fam
    case $pin in
        "") return 0 ;;
        opus | opusplan) fam=opus ;;
        sonnet) fam=sonnet ;;
        haiku) fam=haiku ;;
        *) printf '%s' "$pin"; return 0 ;;
    esac
    models_cached "$id" 2>/dev/null \
        | awk -F'\t' -v f="$fam" 'index(tolower($1), f) { print $1; exit }'
}

# The pin apply_model_selection is about to restore for an OAuth profile: the
# one saved on the way out, else whatever is in settings now.
oauth_pin() {
    local prev=""
    [[ -r $PREV_MODEL ]] && prev=$(<"$PREV_MODEL")
    [[ -n $prev ]] || prev=$(jq -r '.model // empty' "$SETTINGS" 2>/dev/null || true)
    printf '%s' "$prev"
}

# The id that will actually run: skal-swap's own pin on a provider profile,
# Claude Code's (possibly aliased) one on the OAuth profile.
effective_model_of() { # effective_model_of <profile-id> -> model id or empty
    local id=$1
    [[ -n ${P_BASE[$id]:-} ]] && { model_of "$id"; return; }
    resolve_pin "$id" "$(oauth_pin)"
}

# Output cap for the model this profile will actually run: an explicit
# max_output in profiles.conf wins, otherwise whatever the endpoint's own
# catalogue reported for that id. Empty means "say nothing" and let Claude
# Code's 32000 default stand.
max_output_of() { # max_output_of <profile-id> -> tokens or empty
    local id=$1 model
    [[ -n ${P_MAX_OUTPUT[$id]:-} ]] && { printf '%s' "${P_MAX_OUTPUT[$id]}"; return; }
    model=$(effective_model_of "$id") || return 0
    [[ -n $model ]] || return 0
    models_cached "$id" 2>/dev/null \
        | awk -F'\t' -v m="$model" '$1 == m && $3 ~ /^[0-9]+$/ { print $3; exit }'
}

set_model_for() { # set_model_for <profile-id> <model-id>
    mkdir -p "$STATE_DIR"
    printf '%s' "$2" >|"$(model_state "$1")"
}

PREV_MODEL="$STATE_DIR/prev-model"

# context >= 1M gets [1m] appended to model ids: for an id Claude Code doesn't
# know, its believed window (and with it the auto-compact window, which is
# clamped to that) tops out at 200k otherwise. The suffix never reaches the
# API — the client strips it and sends the 1m beta handling instead.
context_1m() { # context_1m <profile-id> -> 0 when the profile declared >=1M
    [[ ${P_CONTEXT[$1]:-} =~ ^[0-9]+$ && ${P_CONTEXT[$1]} -ge 1000000 ]]
}

context_suffix() { # context_suffix <profile-id> <model-id>
    context_1m "$1" || { printf '%s' "$2"; return; }
    [[ $2 == *"[1m]" ]] && { printf '%s' "$2"; return; }
    printf '%s[1m]' "$2"
}

# The endpoint's catalogue as a modelPicker lineup. modelPicker replaces the
# built-in list, so it is written only for endpoints that report models and
# removed again when returning to the OAuth profile.
picker_json() { # picker_json <profile-id>
    local id=$1 tsv
    tsv=$(models_cached "$id")
    [[ -n $tsv ]] || { printf 'null'; return; }
    if context_1m "$id"; then
        tsv=$(printf '%s' "$tsv" | awk -F'\t' -v OFS='\t' '$1 !~ /\[1m\]$/ {$1 = $1 "[1m]"} {print}')
    fi
    # Schema: an object with an "options" array of {model, label?,
    # description?, behavesAs?} rows — not a bare array.
    #
    # behaves_as names a model this Claude Code build knows, and its
    # client-side handling (prompt profile, capability and effort defaults)
    # is used for these ids. Without it an unknown id is treated as a current
    # model and gets the full modern feature set, which older gateways reject.
    # replaceBuiltInOptions hides the built-in Claude ids: this endpoint
    # doesn't serve them.
    # Default the capability floor for any third-party endpoint. Without it
    # Claude Code treats an unknown id as a current model and sends the full
    # modern feature set, which plenty of gateways reject outright. Override
    # per profile with behaves_as when your endpoint keeps up.
    local behaves=${P_BEHAVES_AS[$id]:-}
    [[ -z $behaves && -n ${P_BASE[$id]:-} ]] && behaves=$BEHAVES_AS_DEFAULT
    printf '%s' "$tsv" | jq -R -s --arg b "$behaves" '
        {options: (split("\n") | map(select(length > 0)) | map(split("\t"))
                   | map({model: .[0], label: .[1]}
                         + (if $b == "" then {} else {behavesAs: $b} end))),
         replaceBuiltInOptions: true}'
}

apply_model_selection() { # apply_model_selection <profile-id>
    local id=$1 model picker cur
    model=$(context_suffix "$id" "$(model_of "$id")")
    picker=$(picker_json "$id")

    if is_oauth "$id" || [[ -z ${P_BASE[$id]:-} ]]; then
        # Back to Anthropic: hand the picker back to the built-ins and restore
        # whatever model pin was in place before the first third-party switch.
        local prev=""
        [[ -r $PREV_MODEL ]] && prev=$(<"$PREV_MODEL")
        if [[ -n $prev ]]; then
            rewrite "$SETTINGS" --arg m "$prev" '.model = $m | del(.modelPicker)'
            rm -f "$PREV_MODEL"
        else
            rewrite "$SETTINGS" 'del(.modelPicker)'
        fi
        return
    fi

    if [[ ! -e $PREV_MODEL ]]; then
        mkdir -p "$STATE_DIR"
        cur=$(jq -r '.model // empty' "$SETTINGS" 2>/dev/null || true)
        printf '%s' "$cur" >|"$PREV_MODEL"
    fi

    if [[ -n $model && $picker != "null" ]]; then
        rewrite "$SETTINGS" --arg m "$model" --argjson p "$picker" \
            '.model = $m | .modelPicker = $p'
    elif [[ -n $model ]]; then
        rewrite "$SETTINGS" --arg m "$model" '.model = $m | del(.modelPicker)'
    elif [[ $picker != "null" ]]; then
        rewrite "$SETTINGS" --argjson p "$picker" '.modelPicker = $p | del(.model)'
    else
        rewrite "$SETTINGS" 'del(.modelPicker)'
    fi
}

live_fingerprint() {
    jq -r '.oauthAccount.accountUuid // .oauthAccount.emailAddress // empty' "$CLAUDE_JSON" 2>/dev/null || true
}

# Pre-homes state: which OAuth profile the old bundle swapper last loaded.
# Read only to claim an unowned login after the upgrade; never written again.
active_oauth() {
    [[ -r $OAUTH_STATE ]] || return 0
    cat "$OAUTH_STATE"
}

# Claim the login that's in ~/.claude right now as a profile (for a login
# made with plain claude /login). New logins are simpler with `login`.
cmd_oauth_add() { # cmd_oauth_add <id> [--name N] [--force]
    local id=${1:?usage: skal-swap oauth-add <id> [--name N]}
    shift
    local name="" force=0
    while [[ $# -gt 0 ]]; do
        case $1 in
        --name) name=$2; shift 2 ;;
        --force) force=1; shift ;;
        *) die "unknown option: $1" ;;
        esac
    done
    has_creds "$CREDS" || die "no OAuth session in $CREDS. Log in first (claude /login), or use: skal-swap login $id"

    load_profiles
    [[ -z ${PROFILE_SET[$id]:-} || $force == 1 ]] || die "profile [$id] exists (use --force to claim the live login for it)"
    local fp owner
    fp=$(live_fingerprint)
    owner=$(profile_by_fp "$fp")
    [[ -z $owner || $owner == "$id" ]] || die "the live login already belongs to [$owner]"
    if [[ -z ${PROFILE_SET[$id]:-} ]]; then
        name=${name:-$(jq -r '.oauthAccount.displayName // .oauthAccount.emailAddress // "Claude login"' "$CLAUDE_JSON")}
        printf '\n[%s]\nname = "%s"\noauth = true\n' "$id" "$name" >>"$PROFILES"
        PROFILE_IDS+=("$id"); PROFILE_SET[$id]=1; P_OAUTH[$id]=1
    fi
    prepare_home "$id"
    rewrite "$(home_of "$id")/.claude.json" --slurpfile g "$CLAUDE_JSON" '.oauthAccount = $g[0].oauthAccount'
    echo "claimed the live login as [$id] (${fp:0:8}…). It stays in ~/.claude while the machine is on it"
}

# Same label rule as the ai-usagebar multi-account shim, so usage ids match.
sanitize_label() { printf '%s' "$1" | sed 's/[^A-Za-z0-9_.-]/_/g'; }

# ai-usagebar vendors fetchable per-key (the shim synthesizes a config for
# each). Entry ids in the usage report equal these names.
readonly -a USAGE_VENDORS=(zai openrouter deepseek kimi kilo novita moonshot grok minimax opencode-go)

usage_vendor_of_host() { # -> vendor name, or fails for uncovered hosts
    case $1 in
    api.z.ai | z.ai | open.bigmodel.cn) echo zai ;;
    openrouter.ai | api.openrouter.ai) echo openrouter ;;
    api.deepseek.com | deepseek.com | api.deepseek.cn) echo deepseek ;;
    api.moonshot.cn) echo moonshot ;;
    api.moonshot.ai | kimi.com | api.kimi.com) echo kimi ;;
    kilo.ai | api.kilo.ai) echo kilo ;;
    api.novita.ai | novita.ai) echo novita ;;
    api.x.ai | x.ai) echo grok ;;
    api.minimax.io | minimax.io | api.minimaxi.com) echo minimax ;;
    opencode.ai | api.opencode.ai) echo opencode-go ;;
    api.anthropic.com) echo anthropic ;;
    *) return 1 ;;
    esac
}

usage_id_of() { # usage_id_of <profile-id> <current-id> -> usage entry id or ""
    local id=$1 cur=$2 marker=${P_USAGE[$id]:-} vendor p
    # Claude logins report their own limits (oauth_usage_entries), one entry
    # per profile, so every plan has numbers whichever one the machine is on.
    is_oauth "$id" && { echo "claude@$id"; return 0; }
    if [[ -n $marker ]]; then
        for v in "${USAGE_VENDORS[@]}"; do
            [[ $v == "$marker" ]] || continue
            local label=$(label_of "$id")
            [[ -n $label ]] || label=$id
            echo "$marker@$(sanitize_label "$label")"
            return 0
        done
        return 0 # unknown marker: no usage
    fi
    vendor=$(usage_vendor_of_host "$(host_of "${P_BASE[$id]:-}")") || return 0
    if [[ $vendor == anthropic ]]; then
        # The anthropic entry reports the LIVE OAuth credentials, which our
        # OAuth switching swaps — attach it to the current profile only.
        [[ $cur == "$id" ]] && echo anthropic
        return 0
    fi
    # A key vendor's stock entry reflects one account. Attach it when this
    # is the only profile on that host; with several, ask for usage markers
    # (otherwise every row would show the same account's numbers).
    for p in "${PROFILE_IDS[@]}"; do
        [[ $p != "$id" ]] || continue
        if [[ $(usage_vendor_of_host "$(host_of "${P_BASE[$p]:-}")") == "$vendor" ]]; then
            return 0
        fi
    done
    echo "$vendor"
}

settings_env() { jq -r --arg k "$1" '.env[$k] // empty' "$SETTINGS" 2>/dev/null || true; }

# Which profile (if any) the live settings correspond to. Token match first;
# then the active OAuth profile (state file), then plain tokenless profiles.
current_id() {
    local id ct cb tok base oa
    ct=$(settings_env ANTHROPIC_AUTH_TOKEN)
    cb=$(settings_env ANTHROPIC_BASE_URL)
    if [[ -n $ct ]]; then
        for id in "${PROFILE_IDS[@]}"; do
            [[ ${P_TOKEN[$id]:-} == "$ct" ]] && { echo "$id"; return 0; }
        done
        return 1
    fi
    if [[ -z $cb ]]; then
        # On a Claude login: whoever owns the login in ~/.claude.
        oa=$(global_owner)
        [[ -n $oa ]] && { echo "$oa"; return 0; }
    fi
    for id in "${PROFILE_IDS[@]}"; do
        tok=${P_TOKEN[$id]:-} base=${P_BASE[$id]:-}
        [[ -n $tok ]] && continue
        if [[ -z $base && -z $cb ]] || [[ -n $base && $base == "$cb" ]]; then
            echo "$id"; return 0
        fi
    done
    return 1
}

rewrite() { # rewrite <file> <jq-args…> (filter last) — atomic, keeps inode/perms
    local file=$1
    shift
    local tmp rc
    tmp=$(mktemp)
    if jq "$@" "$file" >"$tmp"; then
        cat "$tmp" >"$file"
        rc=0
    else
        rc=$?
        echo "skal-swap: jq failed on $file — left untouched" >&2
    fi
    rm -f "$tmp"
    return "$rc"
}

apply_profile() { # apply_profile <id>
    local id=$1
    [[ -n ${PROFILE_SET[$id]:-} ]] || die "no profile '$id' (see: skal-swap list)"
    [[ -f $SETTINGS ]] || die "no $SETTINGS — run claude once first"

    # A Claude login moves into ~/.claude, and whichever login was there moves
    # back to its own home first. Switching to a provider leaves the login
    # where it is: provider sessions never touch it, and other tools (the
    # Omarchy usage bar) keep reading the machine's Claude login meanwhile.
    if is_oauth "$id"; then
        import_legacy_store "$id"
        if [[ $(global_owner) != "$id" ]]; then
            has_creds "$(home_of "$id")/.credentials.json" ||
                die "[$id] isn't logged in on this machine. Run: skal-swap login $id"
            checkin || die "not switching: that would overwrite a login no profile owns"
            checkout "$id"
        fi
    fi

    write_settings_for "$id"
    rm -f "$OAUTH_STATE"
    echo "switched to $(label_of "$id") — restart running claude sessions to pick it up"
}

# Write a profile's managed keys into $SETTINGS (and drop the resolved-model
# cache in $CLAUDE_JSON). Shared by `use` (~/.claude) and `run` (the
# profile's home, with both paths pointed there).
write_settings_for() { # write_settings_for <id>
    local id=$1
    local -a pairs=()
    [[ -n ${P_TOKEN[$id]:-} ]] && pairs+=("ANTHROPIC_AUTH_TOKEN"$'\t'"${P_TOKEN[$id]}")
    [[ -n ${P_BASE[$id]:-} ]] && pairs+=("ANTHROPIC_BASE_URL"$'\t'"${P_BASE[$id]}")

    # Declaring the endpoint's real context window: for model ids it doesn't
    # know, Claude Code only warns about the window it assumes — it never
    # enforces it, so auto-compact never arms on third-party endpoints. The
    # env var declares it, the autoCompactWindow setting enforces it (clamped
    # to the model's believed window, which is why 1M endpoints also need the
    # [1m] suffix from context_suffix/picker_json).
    local acw=""
    if ! is_oauth "$id" && [[ -n ${P_CONTEXT[$id]:-} ]]; then
        pairs+=("CLAUDE_CODE_MAX_CONTEXT_TOKENS"$'\t'"${P_CONTEXT[$id]}")
        acw=${P_CONTEXT[$id]}
    fi

    # Claude Code caps a response at 32000 output tokens unless told otherwise,
    # and hands back "response exceeded the 32000 output token maximum" when a
    # model would have written more. max_output_of reads the real cap off the
    # endpoint's catalogue (or the profile's own max_output), including for
    # OAuth profiles, where that 32000 is Claude Code's own default rather than
    # anything the endpoint asked for. Empty leaves the default in charge.
    local maxout; maxout=$(max_output_of "$id" || true)
    [[ -n $maxout ]] && pairs+=("CLAUDE_CODE_MAX_OUTPUT_TOKENS"$'\t'"$maxout")

    # Model selection is applied separately, in apply_model_selection: it
    # rides settings.json's "model" key rather than ANTHROPIC_MODEL, because
    # the env var outranks the key and would override anything picked with
    # /model mid-session. The managed env keys stay in MANAGED_BASE so an
    # older profile's ANTHROPIC_MODEL still gets cleared here.

    local line pid key val
    for line in "${ENV_LINES[@]}"; do
        IFS=$'\t' read -r pid key val <<<"$line"
        [[ $pid == "$id" ]] || continue
        pairs+=("$key"$'\t'"$val")
    done

    local -a managed=("${MANAGED_BASE[@]}")
    for line in "${ENV_LINES[@]}"; do
        IFS=$'\t' read -r pid key val <<<"$line"
        managed+=("$key")
    done

    local pairs_json managed_json
    pairs_json=$(printf '%s\n' "${pairs[@]:-}" \
        | jq -R -s 'split("\n") | map(select(length > 0)) | map(split("\t"))
                    | reduce .[] as [$k, $v] ({}; .[$k] = $v)')
    managed_json=$(printf '%s\n' "${managed[@]}" | sort -u \
        | jq -R -s 'split("\n") | map(select(length > 0))')

    rewrite "$SETTINGS" \
        --argjson del_keys "$managed_json" --argjson add_pairs "$pairs_json" --argjson acw "${acw:-null}" \
        '.env = ((.env // {})
                 | with_entries(. as $e | select(($del_keys | index($e.key)) == null))
                 + $add_pairs)
          | if $acw == null then del(.autoCompactWindow) else .autoCompactWindow = $acw end'
    apply_model_selection "$id"
    chmod 600 "$SETTINGS"

    # Claude Code caches the *resolved* model id per entrypoint in
    # ~/.claude.json (clientDataCacheSlots), keyed without regard to
    # ANTHROPIC_BASE_URL. A slot filled under the OAuth profile hands the engine
    # a literal Anthropic id (claude-sonnet-5), which a third-party gateway
    # rejects with an invalid-parameter 400. Drop the cache so the slot alias
    # re-resolves through this profile's ANTHROPIC_DEFAULT_*_MODEL mapping.
    if [[ -f $CLAUDE_JSON ]]; then
        rewrite "$CLAUDE_JSON" 'del(.clientDataCacheSlots)'
    fi
}

status_json() {
    local cur id uid prefix owner login rows=""
    cur=$(current_id) || cur=""
    owner=$(global_owner)
    count_sessions
    for id in "${PROFILE_IDS[@]}"; do
        prefix=${P_TOKEN[$id]:-}
        [[ -n $prefix ]] && prefix=$(mask "$prefix")
        uid=$(usage_id_of "$id" "$cur")
        login=null
        is_oauth "$id" && login=$(login_json "$id" "$owner")
        local sessions=${SESSIONS[$(home_of "$id")]:-0}
        # Sessions on ~/.claude run whatever the machine is on.
        [[ $id == "$cur" ]] && sessions=$(( sessions + ${SESSIONS[@default]:-0} ))
        rows+=$(jq -nc --arg id "$id" --arg name "$(label_of "$id")" --arg host "$(host_of "${P_BASE[$id]:-}")" \
            --arg tp "$prefix" --arg uid "$uid" --arg icon "$(icon_of "$id")" \
            --argjson oauth "$(is_oauth "$id" && echo true || echo false)" \
            --argjson login "$login" --argjson sessions "$sessions" \
            '{id: $id, name: $name, host: $host, token_prefix: $tp,
              usage_id: (if $uid == "" then null else $uid end),
              icon: (if $icon == "" then "claude" else $icon end),
              oauth: $oauth, login: $login, sessions: $sessions}')$'\n'
    done
    printf '%s' "$rows" | jq -s --arg cur "$cur" --arg settings "$SETTINGS" --arg hn "$(hostname -s 2>/dev/null || hostname)" \
        --argjson hd "$(herdr_bin >/dev/null && echo true || echo false)" '
        {settings: $settings, hostname: $hn, herdr: $hd,
         current: (if $cur == "" then null else $cur end),
         current_known: ($cur != ""),
         profiles: .}'
}

# Who a login profile is logged in as here, and on which plan.
login_json() { # login_json <id> <global-owner>
    local id=$1 owner=$2 cf af
    if [[ $owner == "$id" ]]; then cf=$CREDS af=$CLAUDE_JSON
    else cf="$(home_of "$id")/.credentials.json" af="$(home_of "$id")/.claude.json"; fi
    if ! has_creds "$cf"; then
        jq -nc --arg email "$(jq -r '.oauthAccount.emailAddress // empty' "$af" 2>/dev/null || true)" \
            '{logged_in: false, email: (if $email == "" then null else $email end), plan: null, where: null, expired: false}'
        return
    fi
    local sub tier exp
    sub=$(jq -r '.claudeAiOauth.subscriptionType // empty' "$cf")
    tier=$(jq -r '.claudeAiOauth.rateLimitTier // empty' "$cf")
    exp=$(creds_expiry "$cf")
    jq -nc --arg email "$(jq -r '.oauthAccount.emailAddress // empty' "$af" 2>/dev/null || true)" \
        --arg plan "$(plan_label "$sub" "$tier")" --arg where "$([[ $cf == "$CREDS" ]] && echo default || echo home)" \
        --argjson exp "${exp:-0}" --argjson now "$(date +%s%3N)" \
        '{logged_in: true, email: (if $email == "" then null else $email end),
          plan: (if $plan == "" then null else $plan end), where: $where,
          expired: ($exp >= 0 and $exp < $now)}'
}

status_human() {
    local cur id
    if cur=$(current_id); then
        local key_desc="login"
        is_oauth "$cur" && key_desc="oauth"
        [[ -n ${P_TOKEN[$cur]:-} ]] && key_desc=$(mask "${P_TOKEN[$cur]}")
        echo "claude code : $(label_of "$cur") ($key_desc) @ $(host_of "${P_BASE[$cur]:-}")"
    else
        local tok
        tok=$(settings_env ANTHROPIC_AUTH_TOKEN)
        echo "claude code : ⚠ ${tok:+$(mask "$tok")} ${tok:-(no token set)} — no profile matches"
    fi
    for id in "${PROFILE_IDS[@]}"; do
        [[ $id == "$cur" ]] && continue
        if is_oauth "$id"; then
            echo "   switch to: $(label_of "$id") (login$(has_creds "$(home_of "$id")/.credentials.json" || echo ", not logged in here"))"
        else
            echo "   switch to: $(label_of "$id") ($(mask "${P_TOKEN[$id]:-none}")) @ $(host_of "${P_BASE[$id]:-}")"
        fi
    done
    return 0
}

cmd_list() {
    local cur id marker
    cur=$(current_id) || cur=""
    printf '%-2s %-16s %-28s %-24s %s\n' "" ID NAME HOST KEY
    for id in "${PROFILE_IDS[@]}"; do
        [[ $id == "$cur" ]] && marker="*" || marker=" "
        printf '%-2s %-16s %-28s %-24s %s\n' "$marker" "$id" "$(label_of "$id")" \
            "$(host_of "${P_BASE[$id]:-}")" "$([[ -n ${P_TOKEN[$id]:-} ]] && mask "${P_TOKEN[$id]}" || echo "(login)")"
    done
}

cmd_swap() { # cmd_swap [profile-id]
    local cur i id pick
    if [[ -n ${1:-} ]]; then
        (( $# == 1 )) || die "usage: skal-swap swap [profile-id]"
        apply_profile "$1"
        return 0
    fi
    # No terminal (bar-widget hotkey, @host): nobody to ask, so swap to the
    # first other profile that can actually be switched to here — logins
    # without credentials on this machine are skipped, and with no candidate
    # at all, say how to add one instead of failing deep inside the switch.
    if [[ ! -t 0 ]]; then
        (( ${#PROFILE_IDS[@]} >= 2 )) || die "need 2+ profiles to swap"
        cur=$(current_id) || cur=""
        local id cands=()
        for id in "${PROFILE_IDS[@]}"; do
            [[ $id != "$cur" ]] || continue
            if is_oauth "$id" && [[ $(global_owner) != "$id" ]] &&
               ! has_creds "$(home_of "$id")/.credentials.json"; then
                continue
            fi
            cands+=("$id")
        done
        (( ${#cands[@]} > 0 )) ||
            die "nothing to swap to: no other profile is logged in on this machine (add one with: skal-swap login <id>)"
        apply_profile "${cands[0]}"
        return 0
    fi
    cur=$(current_id) || cur=""
    printf '%-3s %-2s %-18s %-28s %s\n' "" "" ID NAME HOST
    for i in "${!PROFILE_IDS[@]}"; do
        id=${PROFILE_IDS[$i]}
        printf '%-3s %-2s %-18s %-28s %s\n' "$((i + 1))" \
            "$([[ $id == "$cur" ]] && echo '*' || echo ' ')" \
            "$id" "$(label_of "$id")" "$(host_of "${P_BASE[$id]:-}")"
    done
    read -rp "swap to (number or id, blank to stay): " pick
    [[ -n $pick ]] || return 0
    if [[ $pick =~ ^[0-9]+$ ]]; then
        (( pick >= 1 && pick <= ${#PROFILE_IDS[@]} )) ||
            die "no row $pick (1-${#PROFILE_IDS[@]})"
        pick=${PROFILE_IDS[pick - 1]}
    fi
    apply_profile "$pick"
}

usage_bin() { # <path of the ai-usagebar to use, or fail>
    # ~/.local/bin first: it is where a user-level multi-account shim lives,
    # and GUI-service PATHs often put ~/.cargo/bin ahead of ~/.local/bin —
    # PATH order alone would bypass the shim and lose the per-key accounts.
    local p
    for p in "$HOME/.local/bin/ai-usagebar" "$(command -v ai-usagebar 2>/dev/null || true)" "$HOME/.cargo/bin/ai-usagebar"; do
        [[ -n $p && -x $p ]] && { echo "$p"; return 0; }
    done
    return 1
}

usage_cache() { # <report-json> — store; called with no args = print cached
    local cache="${CCS_STATE:-$HOME/.local/state/skal.swap}/usage.json"
    if [[ $# -eq 0 ]]; then
        [[ -r $cache ]] && cat "$cache"
        return 0
    fi
    mkdir -p "$(dirname "$cache")"
    local tmp
    tmp=$(mktemp)
    jq --argjson now "$(date +%s)" '{fetched_at: $now, report: .}' <<<"$1" >"$tmp" &&
        cat "$tmp" >|"$cache"
    rm -f "$tmp"
}

cmd_usage_json() { # args: --json [--max-age N]  (N=0 always fetches)
    local max_age=300
    case ${1:-} in
    --json) shift ;;
    *) die "usage: skal-swap usage --json [--max-age N]" ;;
    esac
    if [[ ${1:-} == "--max-age" ]]; then
        [[ ${2:-} =~ ^[0-9]+$ ]] || die "--max-age needs a number"
        max_age=$2
    fi

    # Serve-stale-while-revalidate: a fresh cache answers instantly; the
    # multi-account fetch behind it takes tens of seconds (one full report
    # per key), so the picker should never wait on the network.
    if (( max_age > 0 )); then
        local cached fetched
        cached=$(usage_cache)
        if [[ -n $cached ]]; then
            fetched=$(jq -r '.fetched_at // 0' <<<"$cached" 2>/dev/null) || fetched=0
            if (( fetched > 0 && $(date +%s) - fetched < max_age )); then
                jq -c '.report' <<<"$cached"
                return 0
            fi
        fi
    fi

    load_profiles
    # One fetch at a time: the widget, snapshots and fleet polls all land
    # here, and every extra fetch spends the same per-token rate limit. A
    # caller that finds one running gets the cache instead.
    mkdir -p "$STATE_DIR"
    exec 9>"$STATE_DIR/usage.lock"
    if ! flock -n 9; then
        if [[ -n $(usage_cache) ]]; then jq -c '.report' <<<"$(usage_cache)"; else echo '{"entries":[]}'; fi
        return 0
    fi
    local out="" bin report
    if bin=$(usage_bin); then
        out=$(timeout 90 "$bin" usage --json 2>/dev/null) || true
    fi
    if [[ -n $out ]]; then
        report=$(printf '%s' "$out" | jq 'if (type == "object" and has("entries")) then
            {entries: [.entries[] | {id: .id, plan: .plan, status: .status,
                                      short: ([.metrics[]?.value] | join(" · ")),
                                      percent: ([.metrics[]?.percent] | max // 0),
                                      metrics: [.metrics[]? | {label, value, percent, detail, reset_at, severity}],
                                      error: .error}]}
            else {entries: [], error: "unexpected ai-usagebar output"} end')
    elif [[ -n $(usage_cache) ]]; then
        report=$(jq '.report' <<<"$(usage_cache)")   # provider rows: stale beats nothing
    else
        report='{"entries":[]}'
    fi
    local claude prev
    prev=$(usage_cache | jq -c '[.report.entries[]? | select(.id | startswith("claude@"))]' 2>/dev/null)
    claude=$(oauth_usage_entries "${prev:-[]}" "$report")
    report=$(jq --argjson c "$claude" '.entries = ([.entries[] | select(.id | startswith("claude@") | not)] + $c)' <<<"$report")
    printf '%s\n' "$report"
    usage_cache "$report" || true
}

# Each Claude login's own limits, from the endpoint behind Claude Code's
# /usage. The token is only read, never refreshed here: a refresh rotates it,
# and that belongs to the claude sessions using the login. An expired token
# says so instead, and comes back after the next launch.
oauth_usage_entries() { # oauth_usage_entries <previous claude@ entries json> <ai-usagebar report>
    local prev=${1:-[]} base=${2:-'{}'} id cf tok exp resp rows="" plan now_ms dir
    now_ms=$(date +%s%3N)
    for id in "${PROFILE_IDS[@]}"; do
        is_oauth "$id" || continue
        cf=$(creds_file_of "$id")
        [[ -n $cf ]] || continue
        exp=$(creds_expiry "$cf")
        # An idle plan's access token runs out after a few hours, since only
        # a running session refreshes it. With no session on that login,
        # `claude auth status` has Claude Code refresh it (its own lock and
        # rotation, nothing done by hand here). With a session running, that
        # session owns the refresh.
        if (( exp >= 0 && exp < now_ms + 300000 )); then
            if [[ $cf == "$CREDS" ]]; then dir=""; else dir=$(home_of "$id"); fi
            if (( $(sessions_in "$dir") == 0 )); then
                local bin
                if bin=$(claude_bin 2>/dev/null); then
                    if [[ -n $dir ]]; then CLAUDE_CONFIG_DIR=$dir timeout 30 "$bin" auth status >/dev/null 2>&1 || true
                    else timeout 30 "$bin" auth status >/dev/null 2>&1 || true; fi
                fi
                exp=$(creds_expiry "$cf")
            fi
        fi
        tok=$(jq -r '.claudeAiOauth.accessToken // empty' "$cf")
        plan=$(plan_label "$(jq -r '.claudeAiOauth.subscriptionType // empty' "$cf")" \
            "$(jq -r '.claudeAiOauth.rateLimitTier // empty' "$cf")")
        local err=""
        # The login in ~/.claude is the one ai-usagebar's own anthropic entry
        # just read, with the same token. Asking again a second later is what
        # trips the endpoint's rate limit, so reuse its numbers when it got
        # some.
        if [[ $cf == "$CREDS" ]] && jq -e '.entries[]? | select(.id == "anthropic" and .status == "ready" and (.metrics | length) > 0)' <<<"$base" >/dev/null 2>&1; then
            rows+=$(jq -c --arg id "claude@$id" --arg plan "$plan" --argjson now "$(date +%s)" '
                .entries[] | select(.id == "anthropic")
                | [.metrics[] | . + {label: (.label | sub(" *\\(5h\\)$"; "") | sub(" *\\(7d\\)$"; "")
                                              | if . == "Session" or . == "Weekly" then . else "Weekly " + . end)}] as $m
                | {id: $id, plan: $plan, status: "ok", as_of: $now,
                   short: ($m | map("\(.percent)%") | join(" · ")),
                   percent: ([$m[].percent] | max // 0), metrics: $m, error: null}' <<<"$base")$'\n'
            continue
        fi
        if (( exp >= 0 && exp < now_ms )); then
            err="token expired: launch once to refresh, or log in again"
        else
            resp=$(curl -sS -m 10 --max-filesize 1048576 --config /dev/fd/3 "$OAUTH_USAGE_URL" 3<<<"$(
                curl_config_header "authorization" "Bearer $tok"
                curl_config_header "anthropic-beta" "oauth-2025-04-20")" 2>/dev/null) || resp=""
            if [[ -z $resp ]]; then
                err="usage endpoint unreachable"
            elif jq -e '.error' <<<"$resp" >/dev/null 2>&1; then
                err=$(jq -r '.error.message // .error // empty' <<<"$resp" 2>/dev/null || true)
                [[ -n $err ]] || err="usage endpoint error"
            fi
        fi
        if [[ -n $err ]]; then
            # Keep the last good numbers, marked with their age, rather than
            # blanking the row over a rate limit or a blip.
            rows+=$(jq -c --arg id "claude@$id" --arg plan "$plan" --arg err "$err" '
                (map(select(.id == $id and (.metrics | length) > 0)) | first) as $old
                | if $old then $old + {plan: $plan, status: "stale", error: $err}
                  else {id: $id, plan: $plan, status: "error", short: "", percent: 0,
                        metrics: [], error: $err} end' <<<"$prev")$'\n'
            continue
        fi
        rows+=$(jq -c --arg id "claude@$id" --arg plan "$plan" --argjson now "$(date +%s)" '
            def limit_name: if .kind == "session" then "Session"
                       elif .kind == "weekly_all" then "Weekly"
                       elif .kind == "weekly_scoped" then "Weekly " + (.scope.model.display_name // .scope.surface // "scoped")
                       else (.kind // "limit") end;
            def win($l; $w): if $w == null then empty
                             else {label: $l, percent: ($w.utilization | floor), resets_at: $w.resets_at, severity: null} end;
            (if (.limits | type) == "array" and (.limits | length) > 0
             then [.limits[] | {label: limit_name, percent: (.percent // 0), resets_at, severity}]
             else [win("Session"; .five_hour), win("Weekly"; .seven_day)] end) as $m
            | {id: $id, plan: $plan, status: "ok", as_of: $now,
               short: ($m | map("\(.percent)%") | join(" · ")),
               percent: ([$m[].percent] | max // 0),
               metrics: [$m[] | {label, value: "\(.percent)%", percent, detail: null,
                                 reset_at: .resets_at, severity}],
               error: null}' <<<"$resp" 2>/dev/null)$'\n'
    done
    printf '%s' "$rows" | jq -s 'map(select(. != null))'
}

# --- other machines -------------------------------------------------------
#
# hosts.conf names the machines the widget shows next to this one:
#
#     devbox = outcrop-labs        # name = ssh destination
#
# Each host runs its own copy of this CLI (`push` installs it) with its own
# profiles and logins; nothing here reaches into another machine's files.

declare -a HOST_NAMES=()
declare -A HOST_DEST=()

load_hosts() {
    [[ -r $HOSTS_FILE ]] || return 0
    local name dest
    while IFS=$'\t' read -r name dest; do
        [[ -n $name && -n $dest ]] || continue
        HOST_NAMES+=("$name"); HOST_DEST[$name]=$dest
    done < <(awk '
        /^[ \t]*(#|$)/ { next }
        { sub(/[ \t]#.*$/, "")
          if (index($0, "=")) { n = substr($0, 1, index($0, "=") - 1); d = substr($0, index($0, "=") + 1) }
          else { n = $1; d = $2 }
          gsub(/^[ \t]+|[ \t]+$/, "", n); gsub(/^[ \t]+|[ \t]+$/, "", d)
          print n "\t" d }' "$HOSTS_FILE")
}

host_dest() { # host_dest <name> -> ssh destination
    load_hosts
    [[ -n ${HOST_DEST[$1]:-} ]] || die "no host '$1' in $HOSTS_FILE"
    printf '%s' "${HOST_DEST[$1]}"
}

REMOTE_CLI='~/.local/bin/skal-swap'

remote_cmd() { # remote_cmd <args…> -> the remote CLI invocation, quoted
    local out=$REMOTE_CLI a
    for a in "$@"; do out+=" $(printf '%q' "$a")"; done
    printf '%s' "$out"
}

cmd_at() { # cmd_at <host> <cmd…>
    local name=$1 dest
    shift
    dest=$(host_dest "$name")
    [[ $# -gt 0 ]] || set -- status
    case $1 in
    run | login | edit)
        # A terminal, and a login shell so claude starts with the user's
        # full environment (mise, PATH) like a session opened by hand.
        local inner
        inner="exec $(remote_cmd "$@")"
        exec ssh -t "$dest" "exec \"\${SHELL:-/bin/sh}\" -lic $(printf '%q' "$inner")"
        ;;
    *)
        exec ssh -o BatchMode=yes -o ConnectTimeout=5 "$dest" "$(remote_cmd "$@")"
        ;;
    esac
}

cmd_hosts() {
    load_hosts
    if [[ ${1:-} == "--json" ]]; then
        local n rows=""
        for n in "${HOST_NAMES[@]}"; do rows+="$n"$'\t'"${HOST_DEST[$n]}"$'\n'; done
        printf '%s' "$rows" | jq -R -s 'split("\n") | map(select(length > 0) | split("\t") | {name: .[0], dest: .[1]})'
        return
    fi
    [[ ${#HOST_NAMES[@]} -gt 0 ]] || { echo "no hosts yet. Add 'name = ssh-destination' lines to $HOSTS_FILE"; return 0; }
    for n in "${HOST_NAMES[@]}"; do printf '%-12s %s\n' "$n" "${HOST_DEST[$n]}"; done
}

cmd_push() { # cmd_push <host> [--profiles]
    local name=${1:?usage: skal-swap push <host> [--profiles]} dest
    dest=$(host_dest "$name")
    ssh -o BatchMode=yes "$dest" 'command -v jq >/dev/null && command -v curl >/dev/null' ||
        die "$name needs jq and curl installed"
    ssh -o BatchMode=yes "$dest" 'mkdir -p ~/.local/bin && cat > ~/.local/bin/skal-swap.new && chmod 755 ~/.local/bin/skal-swap.new && mv -f ~/.local/bin/skal-swap.new ~/.local/bin/skal-swap' \
        <"$(readlink -f "${BASH_SOURCE[0]}")"
    echo "installed skal-swap on $name ($dest)"
    if [[ ${2:-} == "--profiles" ]]; then
        # Provider keys only travel when the host has no profiles yet; Claude
        # logins never travel (each machine runs `login` itself).
        if ssh -o BatchMode=yes "$dest" 'test -e ~/.config/skal.swap/profiles.conf'; then
            echo "$name already has a profiles.conf, left alone"
        else
            ssh -o BatchMode=yes "$dest" 'umask 077 && mkdir -p ~/.config/skal.swap && cat > ~/.config/skal.swap/profiles.conf' <"$PROFILES"
            echo "copied profiles.conf to $name. Log Claude plans in there with: skal-swap @$name login <id>"
        fi
    fi
}

# This machine in one JSON: status plus usage. Usage comes from the cache
# whatever its age, with a detached refresh when it's stale, so a snapshot
# (and the widget waiting on one over ssh) never blocks on the network.
cmd_snapshot() {
    load_profiles
    local status usage fetched
    status=$(status_json)
    usage=$(usage_cache)
    fetched=$( [[ -n $usage ]] && jq -r '.fetched_at // 0' <<<"$usage" || echo 0)
    if (( $(date +%s) - fetched >= 300 )); then
        setsid "$(readlink -f "${BASH_SOURCE[0]}")" usage --json --max-age 300 </dev/null >/dev/null 2>&1 &
    fi
    [[ -n $usage ]] && usage=$(jq -c '.report' <<<"$usage") || usage='{"entries":[]}'
    jq -nc --argjson s "$status" --argjson u "$usage" --argjson f "$fetched" \
        '{status: $s, usage: $u, usage_fetched_at: $f}'
}

cmd_fleet() {
    load_hosts
    local tmp n self
    tmp=$(mktemp -d)
    self=$(readlink -f "${BASH_SOURCE[0]}")
    for n in "${HOST_NAMES[@]}"; do
        ( timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=5 "${HOST_DEST[$n]}" \
              "$(remote_cmd snapshot)" >"$tmp/$n.json" 2>"$tmp/$n.err" </dev/null ||
              echo $? >"$tmp/$n.rc" ) &
    done
    "$self" snapshot >"$tmp/.local.json" 2>/dev/null || echo '{}' >"$tmp/.local.json"
    wait
    local rows=""
    rows+=$(jq -c '{name: "local", dest: null, local: true, ok: true, error: null} + .' "$tmp/.local.json")$'\n'
    for n in "${HOST_NAMES[@]}"; do
        if [[ ! -e $tmp/$n.rc ]] && jq -e '.status' "$tmp/$n.json" >/dev/null 2>&1; then
            rows+=$(jq -c --arg n "$n" --arg d "${HOST_DEST[$n]}" \
                '{name: $n, dest: $d, local: false, ok: true, error: null} + .' "$tmp/$n.json")$'\n'
        else
            local err
            err=$(tail -1 "$tmp/$n.err" 2>/dev/null)
            [[ -n $err ]] || err="unreachable"
            [[ $err == *skal-swap* && ( $err == *"o such file"* || $err == *"not found"* ) ]] && err="skal-swap not installed. Run: skal-swap push $n"
            rows+=$(jq -nc --arg n "$n" --arg d "${HOST_DEST[$n]}" --arg e "$err" \
                '{name: $n, dest: $d, local: false, ok: false, error: $e, status: null, usage: null}')$'\n'
        fi
    done
    rm -rf "$tmp"
    printf '%s' "$rows" | jq -sc '{hosts: .}'
}

# --- herdr ----------------------------------------------------------------
#
# herdr (herdr.dev) runs agents in a persistent terminal workspace. `herdr
# <id>` opens a tab there with CLAUDE_CONFIG_DIR set for the profile and
# starts claude in it through `herdr agent start`, so herdr recognises it as
# a claude agent like any other. On another machine (`@host herdr <id>`) the
# tab lands in that machine's herdr server, which the local herdr shows under
# its saved SSH machine.

herdr_bin() {
    local p
    for p in "${CCS_HERDR_BIN:-}" "$(command -v herdr 2>/dev/null || true)" "$HOME/.local/bin/herdr" \
        "$HOME/.cargo/bin/herdr"; do
        [[ -n $p && -x $p ]] && { printf '%s' "$p"; return 0; }
    done
    return 1
}

herdr_running() { "$@" status server 2>/dev/null | grep -q 'status: running'; }

# Agent names are [a-z][a-z0-9_-]{0,31} and unique among live agents.
herdr_agent_name() { # herdr_agent_name <profile-id> <herdr argv…>
    local id=$1 base n=1 name taken
    shift
    base=$(printf '%s' "$id" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9_-' '-' | sed 's/^[^a-z]*//')
    base=${base:0:28}
    [[ -n $base ]] || base=claude
    taken=$("$@" agent list 2>/dev/null | jq -r '.. | objects | .name? // empty' 2>/dev/null || true)
    name=$base
    while grep -qxF "$name" <<<"$taken"; do n=$((n + 1)); name="$base-$n"; done
    printf '%s' "$name"
}

cmd_herdr() { # cmd_herdr [-y] <id> [--cwd DIR] [--workspace] [--no-focus] [-- claude args]
    local id="" yolo=0 cwd=$HOME new_ws=0 focus=1 session=""
    while [[ $# -gt 0 ]]; do
        case $1 in
        -y | --yolo | --skip-permissions) yolo=1; shift ;;
        --cwd) cwd=${2:?--cwd needs a directory}; shift 2 ;;
        --workspace) new_ws=1; shift ;;
        --no-focus) focus=0; shift ;;
        --session) session=${2:?--session needs a name}; shift 2 ;;
        --) shift; break ;;
        -*) die "unknown option: $1" ;;
        *) [[ -z $id ]] || break; id=$1; shift ;;
        esac
    done
    [[ -n $id ]] || die "usage: skal-swap herdr [-y] <id> [--cwd DIR] [--workspace] [--no-focus] [--session S] [-- claude args]"
    (( yolo )) && set -- --dangerously-skip-permissions "$@"
    load_profiles
    local h dir
    h=$(herdr_bin) || die "herdr isn't installed on this machine"
    # A named herdr session is its own server; every call below targets it.
    local -a hs=("$h")
    [[ -n $session ]] && hs+=(--session "$session")
    dir=$(launch_dir "$id") || exit 1

    if ! herdr_running "${hs[@]}"; then
        # No server yet: start a headless one; a client attaches to it later.
        setsid "${hs[@]}" server </dev/null >/dev/null 2>&1 &
        local i
        for i in $(seq 20); do herdr_running "${hs[@]}" && break; sleep 0.25; done
        herdr_running "${hs[@]}" || die "herdr server didn't start"
    fi

    local -a where=(--cwd "$cwd" --label "$(label_of "$id")")
    [[ -n $dir ]] && where+=(--env "CLAUDE_CONFIG_DIR=$dir")
    (( focus )) && where+=(--focus) || where+=(--no-focus)
    local out pane tab
    if (( new_ws )) || ! out=$("${hs[@]}" tab create "${where[@]}" 2>/dev/null); then
        out=$("${hs[@]}" workspace create "${where[@]}") || die "herdr couldn't create a tab or workspace"
    fi
    pane=$(jq -r '.result.root_pane.pane_id // empty' <<<"$out")
    tab=$(jq -r '.result.tab.tab_id // empty' <<<"$out")
    [[ -n $pane ]] || die "herdr returned no pane: $out"

    # The new shell needs a moment to reach its prompt before agent start
    # accepts the pane.
    local name err i
    name=$(herdr_agent_name "$id" "${hs[@]}")
    for i in $(seq 20); do
        if err=$("${hs[@]}" agent start "$name" --kind claude --pane "$pane" -- "$@" 2>&1 >/dev/null); then
            echo "started $name ($(label_of "$id")) in herdr tab $tab"
            return 0
        fi
        # Started, but stopped on a question (folder trust, the skip-
        # permissions warning, a login): it's in the tab, waiting on you.
        if grep -q '"agent_not_ready"' <<<"$err"; then
            echo "started $name ($(label_of "$id")) in herdr tab $tab, waiting on a prompt there"
            return 0
        fi
        # Anything else but a shell that hasn't reached its prompt yet is real.
        grep -qiE 'shell|prompt|busy|not.?available|unavailable' <<<"$err" || break
        sleep 0.5
    done
    die "herdr agent start failed: $err"
}

# Bring the local herdr window to the front, or open one. Uses the herdr
# bar widget's helper when it is installed (it knows which window shows
# which session), else opens a terminal when no herdr client is running.
cmd_herdr_show() {
    local helper="$HOME/.config/omarchy/plugins/jankeesvw.herdr/bin/herdr-sessions"
    if [[ -x $helper ]]; then
        "$helper" open default >/dev/null 2>&1 && return 0
    fi
    pgrep -u "$(id -u)" -xf 'herdr' >/dev/null 2>&1 && return 0
    local h; h=$(herdr_bin) || die "herdr isn't installed on this machine"
    setsid xdg-terminal-exec "$h" </dev/null >/dev/null 2>&1 &
}

# What a machine's herdr looks like, for sync: version, whether its server
# runs, and the agent integrations it has installed.
cmd_herdr_info() {
    local h ver="" running=false ints="[]"
    if h=$(herdr_bin); then
        ver=$("$h" --version 2>/dev/null | awk '{print $2}')
        herdr_running "$h" && running=true
        ints=$("$h" integration status 2>/dev/null | awk -F': ' '$2 ~ /^current/ {sub(/ \(experimental\)/, "", $1); print $1}' |
            jq -R -s 'split("\n") | map(select(length > 0))')
    fi
    jq -nc --arg v "$ver" --argjson r "$running" --argjson i "$ints" --arg b "${h:-}" \
        '{installed: ($b != ""), bin: $b, version: $v, running: $r, integrations: $i}'
}

# Take a herdr config.toml on stdin. An existing different one is kept as a
# timestamped backup; a running server reloads it.
cmd_herdr_config_in() {
    local cfg="$HOME/.config/herdr/config.toml" tmp h
    mkdir -p "$(dirname "$cfg")"
    tmp=$(mktemp)
    cat >"$tmp"
    if [[ -f $cfg ]] && cmp -s "$tmp" "$cfg"; then
        rm -f "$tmp"; echo "herdr config: already current"; return 0
    fi
    [[ -f $cfg ]] && cat "$cfg" >"$cfg.bak-$(date +%Y%m%d-%H%M%S)"
    cat "$tmp" >"$cfg"
    rm -f "$tmp"
    if h=$(herdr_bin) && herdr_running "$h"; then
        "$h" server reload-config >/dev/null 2>&1 && echo "herdr config: updated and reloaded" && return 0
    fi
    echo "herdr config: updated"
}

# Install herdr integrations for the agents this machine actually has (their
# config dir exists or the binary is on PATH); skip the rest.
cmd_herdr_integrations_in() {
    local h n dir bin
    h=$(herdr_bin) || die "herdr isn't installed here"
    # Over ssh this runs without the login shell's PATH; mise's shims and
    # ~/.local/bin are where most agent CLIs live.
    PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$HOME/.bun/bin:$PATH"
    for n in "$@"; do
        case $n in
        claude) dir=.claude bin=claude ;; codex) dir=.codex bin=codex ;;
        pi) dir=.pi bin=pi ;; omp) dir=.omp bin=omp ;;
        opencode) dir=.config/opencode bin=opencode ;; kilo) dir=.config/kilo bin=kilo ;;
        hermes) dir=.hermes bin=hermes ;; cursor) dir=.cursor bin=cursor-agent ;;
        grok) dir=.grok bin=grok ;; copilot) dir=.copilot bin=copilot ;;
        droid) dir=.factory bin=droid ;; kimi) dir=.kimi-code bin=kimi ;;
        qwen) dir=.qwen bin=qwen ;; qodercli) dir=.qoder bin=qodercli ;;
        devin) dir=.config/devin bin=devin ;; mastracode) dir=.mastracode bin=mastracode ;;
        antigravity-cli) dir=.gemini bin=agy ;; letta) dir=.letta bin=letta ;;
        *) dir=".$n" bin=$n ;;
        esac
        # herdr hooks into the agent's own config dir, which only exists
        # once the agent has run here.
        if [[ -d $HOME/$dir ]]; then
            if "$h" integration install "$n" >/dev/null 2>&1; then echo "integration $n: installed"
            else echo "integration $n: install failed (try: herdr integration install $n)"; fi
        elif command -v "$bin" >/dev/null 2>&1; then
            echo "integration $n: skipped ($bin is here but has never run; run it once, then sync again)"
        else
            echo "integration $n: skipped ($bin isn't on this machine)"
        fi
    done
}

# Bring another machine up to this one: this CLI, herdr's config and agent
# integrations, the host entry here, and herdr's saved machine. Safe to run
# again whenever the desktop setup changes.
cmd_sync() { # cmd_sync <host> [--dest ssh-target] [--profiles] [--no-herdr]
    local name="" dest="" profiles="" herdr=1
    while [[ $# -gt 0 ]]; do
        case $1 in
        --dest) dest=${2:?--dest needs an ssh target}; shift 2 ;;
        --profiles) profiles=--profiles; shift ;;
        --no-herdr) herdr=0; shift ;;
        -*) die "unknown option: $1" ;;
        *) name=$1; shift ;;
        esac
    done
    [[ -n $name ]] || die "usage: skal-swap sync <host> [--dest ssh-target] [--profiles] [--no-herdr]"
    [[ $name =~ ^[A-Za-z0-9_.-]+$ ]] || die "host names are letters, digits, . _ and -"
    load_hosts
    if [[ -z ${HOST_DEST[$name]:-} ]]; then
        [[ -n $dest ]] || die "no host '$name' yet. Add it with: skal-swap sync $name --dest user@host"
        mkdir -p "$(dirname "$HOSTS_FILE")"
        printf '%s = %s\n' "$name" "$dest" >>"$HOSTS_FILE"
        HOST_NAMES+=("$name"); HOST_DEST[$name]=$dest
        echo "added $name = $dest to $HOSTS_FILE"
    fi
    dest=${HOST_DEST[$name]}

    cmd_push "$name" $profiles
    (( herdr )) || return 0

    local lh linfo rinfo
    lh=$(herdr_bin) || { echo "herdr isn't installed here, nothing of it to sync"; return 0; }
    linfo=$(cmd_herdr_info)
    rinfo=$(ssh -o BatchMode=yes "$dest" "$(remote_cmd _herdr-info)") || die "couldn't read herdr on $name"

    # herdr's own setup on the far side (install, server) is `herdr machine
    # add`, which also saves the machine here.
    local saved
    saved=$("$lh" machine list --json 2>/dev/null |
        jq -r --arg d "$dest" --arg n "$name" '.[] | select(.target == $d or (.target | endswith("@" + $d)) or .label == $n or .label == $d) | .label' | head -1)
    if [[ -z $saved || $(jq -r '.installed' <<<"$rinfo") != true ]]; then
        if [[ -t 0 ]]; then
            echo "setting up herdr on $name (herdr machine add)…"
            "$lh" machine add --label "$name" "$dest" || die "herdr machine add failed"
            rinfo=$(ssh -o BatchMode=yes "$dest" "$(remote_cmd _herdr-info)")
        else
            echo "herdr isn't set up on $name yet. Run in a terminal: herdr machine add --label $name $dest"
        fi
    else
        echo "herdr machine: saved here as '$saved'"
    fi
    if [[ $(jq -r '.installed' <<<"$rinfo") == true ]]; then
        local lv rv
        lv=$(jq -r '.version' <<<"$linfo"); rv=$(jq -r '.version' <<<"$rinfo")
        [[ $lv == "$rv" ]] || echo "herdr version: $name has $rv, this machine $lv (update with: ssh $dest herdr update)"
        if [[ -f $HOME/.config/herdr/config.toml ]]; then
            ssh -o BatchMode=yes "$dest" "$(remote_cmd _herdr-config-in)" <"$HOME/.config/herdr/config.toml"
        fi
        local -a want=()
        mapfile -t want < <(jq -r --argjson have "$(jq '.integrations' <<<"$rinfo")" \
            '.integrations - $have | .[]' <<<"$linfo")
        if (( ${#want[@]} )); then
            ssh -o BatchMode=yes "$dest" "$(remote_cmd _herdr-integrations-in "${want[@]}")"
        else
            echo "herdr integrations: already match"
        fi
    fi

    # Claude logins never travel; say which ones still need one there.
    local missing
    missing=$(ssh -o BatchMode=yes "$dest" "$(remote_cmd status --json)" 2>/dev/null |
        jq -r '.profiles[] | select(.oauth and (.login.logged_in | not)) | .id' 2>/dev/null || true)
    if [[ -n $missing ]]; then
        echo "not logged in on $name yet:"
        while read -r m; do echo "  skal-swap @$name login $m"; done <<<"$missing"
    fi
}

cmd_init() {
    [[ ! -e $PROFILES || ${1:-} == "--force" ]] || die "$PROFILES already exists (use --force to replace)"
    mkdir -p "$(dirname "$PROFILES")"
    cat >"$PROFILES" <<'EOF'
# Claude Code provider profiles for the skal.swap plugin.
# This file holds secrets: keep it chmod 600 and never commit it.
#
# Only base_url and token are required. Everything else is optional:
#   name         label in the bar and menu     (default: the endpoint host)
#   model        starting model id             (default: newest the endpoint reports)
#   behaves_as   capability floor              (default: claude-sonnet-4-5)
#   context      endpoint context window       (tokens, e.g. 1000000 — arms auto-compact)
#   max_output   longest single response       (tokens — override; normally read off the endpoint)
#   models_url   model-catalogue URL           (default: probed)
#   usage        usage-account marker          (e.g. zai)
#   icon         provider-mark override        (e.g. deepseek)
#   env.<KEY>    extra env written to ~/.claude/settings.json
#
# A section with no base_url or token is your Claude OAuth login.

[zai-plan]
base_url = https://api.z.ai/api/anthropic
token = your-zai-token
context = 1000000
usage = zai

[another-provider]
base_url = https://provider.example/anthropic
token = another-token

[anthropic-login]
name = Claude (OAuth)
EOF
    chmod 600 "$PROFILES"
    echo "wrote example $PROFILES — edit with: skal-swap edit"
}

cmd_edit() {
    [[ -r $PROFILES ]] || cmd_init
    # $EDITOR may carry flags (e.g. "omarchy-launch-editor --inline").
    exec ${EDITOR:-nano} "$PROFILES"
}

cmd_migrate_glm() {
    [[ -r $GLM_KEYS ]] || die "no keystore at $GLM_KEYS"
    [[ ! -e $PROFILES || ${1:-} == "--force" ]] || die "$PROFILES exists (use --force to replace)"
    mkdir -p "$(dirname "$PROFILES")"

    local active_tok
    active_tok=$(settings_env ANTHROPIC_AUTH_TOKEN)

    (
        # shellcheck disable=SC1090
        source "$GLM_KEYS"
        : "${KEY_1:?KEY_1 unset in keystore}" "${KEY_2:?KEY_2 unset in keystore}"
        BASE_URL=${BASE_URL:-https://api.z.ai/api/anthropic}
        NAME_1=${NAME_1:-"key 1"}
        NAME_2=${NAME_2:-"key 2"}

        emit() { # emit <id> <name> <token>
            printf '[%s]\nname = "%s"\nbase_url = %s\ntoken = %s\nusage = zai\n' \
                "$1" "$2" "$BASE_URL" "$3"
            printf '\n'
        }

        echo "# Claude Code API profiles — imported $(date +%F) from $GLM_KEYS"
        echo "# by skal-swap migrate-glm. Secrets live here only; keep chmod 600."
        echo
        emit zai-1 "$NAME_1" "$KEY_1"
        emit zai-2 "$NAME_2" "$KEY_2"
        if [[ -n $active_tok && $active_tok != "$KEY_1" && $active_tok != "$KEY_2" ]]; then
            echo "# Key found live in settings.json, in neither keystore slot:"
            emit zai-active "z.ai active (${active_tok:0:8}…)" "$active_tok"
        fi
    ) >"$PROFILES"
    chmod 600 "$PROFILES"

    # Keep the retired-key notes from the old keystore as comments.
    grep '^#' "$GLM_KEYS" >>"$PROFILES" || true
    chmod 600 "$SETTINGS" 2>/dev/null || true

    echo "imported keystore into $PROFILES:"
    load_profiles
    cmd_list
}

main() {
    if [[ ${1:-} == @* ]]; then
        local h=${1#@}
        shift
        cmd_at "$h" "$@"
    fi
    case ${1:-status} in
    status)
        load_profiles
        [[ ${2:-} == "--json" ]] && status_json || status_human
        ;;
    list)
        load_profiles
        cmd_list
        ;;
    use)
        [[ -n ${2:-} ]] || die "usage: skal-swap use <id> [--model <model-id>]"
        load_profiles
        if [[ ${3:-} == "--model" ]]; then
            [[ -n ${4:-} ]] || die "usage: skal-swap use <id> --model <model-id>"
            [[ -n ${PROFILE_SET[$2]:-} ]] || die "no profile '$2' (see: skal-swap list)"
            set_model_for "$2" "$4"
        fi
        apply_profile "$2"
        ;;
    models)
        shift
        load_profiles
        cmd_models "$@"
        ;;
    swap)
        shift
        load_profiles
        cmd_swap "$@"
        ;;
    edit) cmd_edit ;;
    init) cmd_init "${2:-}" ;;
    oauth-add)
        shift
        cmd_oauth_add "$@"
        ;;
    migrate-glm) cmd_migrate_glm "${2:-}" ;;
    run)
        shift
        cmd_run "$@"
        ;;
    login)
        shift
        cmd_login "$@"
        ;;
    hosts) cmd_hosts "${2:-}" ;;
    push)
        shift
        load_profiles
        cmd_push "$@"
        ;;
    snapshot) cmd_snapshot ;;
    herdr)
        shift
        cmd_herdr "$@"
        ;;
    herdr-show) cmd_herdr_show ;;
    sync)
        shift
        load_profiles
        cmd_sync "$@"
        ;;
    _herdr-info) cmd_herdr_info ;;
    _herdr-config-in) cmd_herdr_config_in ;;
    _herdr-integrations-in)
        shift
        cmd_herdr_integrations_in "$@"
        ;;
    fleet) cmd_fleet ;;
    usage)
        shift
        cmd_usage_json "$@"
        ;;
    -h | --help | help) usage 0 ;;
    *) echo "unknown command: $1" >&2; usage 1 ;;
    esac
}

main "$@"
