# Claude Code API profiles for the skal.swap plugin.
# Copy to ~/.config/skal.swap/profiles.conf (chmod 600) or
# just run: skal-swap init
#
# [section-id]         what `skal-swap use <section-id>` switches to
#   name               label shown in the bar and menu
#   base_url           Anthropic-compatible endpoint (omit for official API)
#   token              API token (omit to fall back to claude login/OAuth)
#   env.<KEY>          extra env written to ~/.claude/settings.json
#   usage              optional account marker for usage display (zai)

[zai-plan]
name = Z.AI coding plan
base_url = https://api.z.ai/api/anthropic
token = your-zai-token
usage = zai

[another-provider]
name = Another provider
base_url = https://provider.example/anthropic
token = another-token

# Alibaba Cloud Model Studio token plan (regional gateway; use the host and
# model ids your plan entitles):
[alibaba-qwen]
name = Alibaba Qwen
base_url = https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic
token = sk-sp-…

[anthropic-login]
name = Claude (OAuth)
